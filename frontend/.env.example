# Copy to frontend/.env.local and fill from infrastructure/cdk-outputs.json after deploy.
# These are PUBLIC identifiers (they ship to every browser). Never put secrets or AWS keys in VITE_ variables.

# "mock" = in-memory fake API, no AWS needed. "http" = real deployed API with Cognito login.
VITE_API_MODE=mock

VITE_API_URL=
VITE_AWS_REGION=ap-southeast-1
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
